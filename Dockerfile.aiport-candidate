FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml /app/
COPY requirements-runtime.lock /app/
COPY src /app/src
RUN pip install -r requirements-runtime.lock && pip install --no-deps .
ARG ENABLE_LOCAL_DETECTOR=0
RUN if [ "$ENABLE_LOCAL_DETECTOR" = "1" ]; then \
      pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        'torch==2.14.0+cpu' 'torchvision==0.29.0+cpu' && \
      pip install --no-cache-dir '.[detector]'; \
    fi
ARG ONNX_RUNTIME=none
RUN case "$ONNX_RUNTIME" in \
      none) ;; \
      cpu) pip install --no-cache-dir 'onnxruntime==1.28.0' ;; \
      openvino) pip install --no-cache-dir 'onnxruntime-openvino==1.24.1' ;; \
      *) echo 'Unsupported ONNX_RUNTIME' >&2; exit 1 ;; \
    esac
USER 10001:10001
ENTRYPOINT ["local-aiport-candidate"]
CMD ["--config", "/state/config.json"]
